# Publish only the current desktop app, never local runtime or historical artifacts.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/licenses/
!/requirements-build.txt
!/build.py
!/outputs/
/outputs/*
!/outputs/WifiRecoveryApp.py
!/outputs/wifi_ui.py
!/outputs/scroll_view.py
!/outputs/rounded_theme.py
!/outputs/system_theme.py
!/outputs/startup_settings.py
!/outputs/worker_payload.py
!/outputs/icon_payload.py
!/outputs/WifiWorker.ps1
!/outputs/Install-DesktopApp.ps1
!/outputs/Update-DesktopApp.ps1
!/outputs/Enable-OneTimeAuthorization.ps1
!/outputs/WifiRecovery.ico
!/outputs/WifiRecovery-icon.png
!/outputs/WifiRecovery.svg
!/work/
/work/*
!/work/test_desktop_app.py
!/work/test_config_equality.py
!/work/test_dpi_layout.py
!/work/test_refresh_efficiency.py
!/work/test_system_theme.py
!/work/test_theme_startup.py
!/work/test_scroll_view.py
